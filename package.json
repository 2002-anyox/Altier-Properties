{
  "name": "altier-properties",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Altier Properties \u2014 premium property management platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noCheck && vite build",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.node.json",
    "preview": "vite preview",
    "build:single": "tsc -b --noCheck && vite build --mode single",
    "check:accounting": "esbuild scripts/check-accounting.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-accounting.mjs --log-level=warning && node node_modules/.cache/check-accounting.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npm run --silent db:build && node node_modules/.cache/db/migrate.mjs",
    "db:seed": "npm run --silent db:build && node node_modules/.cache/db/seed-cli.mjs",
    "db:init": "npm run --silent db:build && node node_modules/.cache/db/init-cli.mjs",
    "db:build": "esbuild server/db/seed-cli.ts server/db/init-cli.ts server/db/migrate.ts server/db/verify.ts --bundle --platform=node --format=esm --packages=external --outdir=node_modules/.cache/db --out-extension:.js=.mjs --log-level=warning",
    "db:check": "npm run --silent db:build && node node_modules/.cache/db/verify.mjs",
    "api:build": "esbuild server/serve.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/db/api.mjs --log-level=warning",
    "api": "npm run --silent api:build && node node_modules/.cache/db/api.mjs",
    "smoke:api": "npm run --silent api:build && node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.460.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
