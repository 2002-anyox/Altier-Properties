# Postgres connection for migrations, seeding and the round-trip check.
# Leave unset to fall back to PGlite (Postgres in WebAssembly, no server).
#
#   docker run -d --name altier-pg -p 5432:5432 \
#     -e POSTGRES_USER=altier -e POSTGRES_PASSWORD=altier -e POSTGRES_DB=altier \
#     postgres:16-alpine
#
DATABASE_URL=postgres://altier:altier@localhost:5432/altier

# Where PGlite persists when DATABASE_URL is unset. Omit for in-memory.
# PGLITE_PATH=.pglite
