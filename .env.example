# Postgres connection for migrations, seeding, the round-trip check and the
# API. Required in production — the deployed function refuses to start without
# it rather than fall back to a database that disappears between requests.
#
# Local Postgres in Docker:
#   docker run -d --name altier-pg -p 5432:5432 \
#     -e POSTGRES_USER=altier -e POSTGRES_PASSWORD=altier -e POSTGRES_DB=altier \
#     postgres:16-alpine
#
# Hosted (Neon, Supabase, Vercel Postgres): use the POOLED connection string.
# A serverless function opens a connection per instance, and the unpooled
# endpoint runs out of them under any real traffic.
#
DATABASE_URL=postgres://altier:altier@localhost:5432/altier

# Where PGlite persists when DATABASE_URL is unset. Defaults to .pglite;
# set it to memory:// for a throwaway database.
# PGLITE_PATH=.pglite

# Port the API listens on locally. The Vite dev server proxies /api here.
# API_PORT=5174
